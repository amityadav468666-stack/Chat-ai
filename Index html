<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#10a37f">
<meta name="description" content="Chat AI - AI Search, Web Search, Chat, PDF and Image Analysis">
<title>Chat AI — AI Search & Chat</title>

<style>
*{box-sizing:border-box}

:root{
  --bg:#f7f7f8;
  --panel:#fff;
  --panel2:#f1f3f5;
  --text:#171717;
  --muted:#6b7280;
  --border:#e5e7eb;
  --accent:#10a37f;
  --accent2:#0d8f70;
  --user:#e8f5e9;
  --danger:#dc2626;
  --shadow:0 8px 30px rgba(0,0,0,.08)
}

body.dark{
  --bg:#0d1117;
  --panel:#161b22;
  --panel2:#21262d;
  --text:#f0f6fc;
  --muted:#8b949e;
  --border:#30363d;
  --accent:#19c37d;
  --accent2:#16a66a;
  --user:#19352b;
  --danger:#f85149;
  --shadow:0 8px 30px rgba(0,0,0,.3)
}

html,body{
  margin:0;
  padding:0;
  width:100%;
  min-height:100%
}

body{
  background:var(--bg);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
  overflow-x:hidden
}

button,input,textarea{font:inherit}
button{cursor:pointer}

.app{
  min-height:100vh;
  display:flex
}

/* SIDEBAR */

.sidebar{
  position:fixed;
  left:0;
  top:0;
  bottom:0;
  width:280px;
  z-index:100;
  display:flex;
  flex-direction:column;
  padding:14px;
  background:var(--panel);
  border-right:1px solid var(--border);
  transition:transform .25s ease
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  padding:8px 6px 18px;
  font-size:21px;
  font-weight:800
}

.brand-icon{
  width:38px;
  height:38px;
  border-radius:12px;
  display:grid;
  place-items:center;
  background:var(--accent);
  color:#fff;
  font-size:13px;
  font-weight:900
}

.new-chat{
  width:100%;
  border:1px solid var(--border);
  border-radius:12px;
  background:var(--panel);
  color:var(--text);
  padding:12px;
  text-align:left;
  font-weight:700
}

.new-chat:hover{
  background:var(--panel2);
  border-color:var(--accent)
}

.history-heading{
  margin:20px 5px 8px;
  color:var(--muted);
  font-size:12px;
  font-weight:700;
  text-transform:uppercase
}

.history{
  flex:1;
  overflow-y:auto;
  overflow-x:hidden
}

.history-empty{
  color:var(--muted);
  font-size:12px;
  padding:10px 5px
}

.history-item{
  display:flex;
  align-items:center;
  gap:6px;
  width:100%;
  padding:10px;
  margin-bottom:3px;
  border-radius:10px
}

.history-item:hover{
  background:var(--panel2)
}

.history-question{
  flex:1;
  min-width:0;
  color:var(--text);
  font-size:13px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}

.history-delete{
  flex:none;
  border:0;
  background:transparent;
  color:var(--muted);
  padding:5px;
  border-radius:7px
}

.history-delete:hover{
  color:var(--danger);
  background:var(--panel2)
}

.sidebar-bottom{
  border-top:1px solid var(--border);
  padding-top:10px;
  margin-top:10px
}

.side-button{
  width:100%;
  border:0;
  border-radius:9px;
  background:transparent;
  color:var(--text);
  padding:10px;
  text-align:left;
  font-size:13px
}

.side-button:hover{
  background:var(--panel2)
}

.account{
  margin-top:8px;
  padding:10px;
  border:1px solid var(--border);
  border-radius:12px;
  display:none
}

.account-row{
  display:flex;
  align-items:center;
  gap:9px
}

.account-photo{
  width:34px;
  height:34px;
  border-radius:50%;
  object-fit:cover;
  background:var(--panel2)
}

.account-details{
  min-width:0;
  flex:1
}

.account-name{
  font-size:12px;
  font-weight:700;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}

.account-email{
  color:var(--muted);
  font-size:10px;
  margin-top:2px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}

.login-button{
  width:100%;
  margin-top:9px;
  border:1px solid var(--border);
  border-radius:9px;
  padding:9px;
  background:var(--panel);
  color:var(--text);
  font-weight:600
}

.login-button:hover{
  border-color:var(--accent)
}

/* MAIN */

.main{
  width:calc(100% - 280px);
  margin-left:280px;
  min-height:100vh;
  display:flex;
  flex-direction:column
}

.topbar{
  position:sticky;
  top:0;
  z-index:50;
  height:62px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 20px;
  background:var(--panel);
  border-bottom:1px solid var(--border)
}

.top-left{
  display:flex;
  align-items:center;
  gap:10px
}

.top-title{
  font-size:16px;
  font-weight:800
}

.menu-button{
  display:none;
  width:38px;
  height:38px;
  border:0;
  border-radius:10px;
  background:transparent;
  color:var(--text);
  font-size:21px
}

.menu-button:hover{
  background:var(--panel2)
}

.top-actions{
  display:flex;
  gap:6px
}

.icon-button{
  width:38px;
  height:38px;
  border:1px solid var(--border);
  border-radius:10px;
  background:var(--panel);
  color:var(--text)
}

.icon-button:hover{
  background:var(--panel2)
}

/* CHAT */

.chat-area{
  width:100%;
  max-width:920px;
  margin:0 auto;
  padding:35px 20px 180px;
  flex:1
}

.welcome{
  text-align:center;
  padding:80px 10px 35px
}

.welcome-logo{
  width:64px;
  height:64px;
  margin:0 auto 18px;
  display:grid;
  place-items:center;
  border-radius:20px;
  background:var(--accent);
  color:#fff;
  font-size:20px;
  font-weight:900;
  box-shadow:var(--shadow)
}

.welcome h1{
  margin:0 0 10px;
  font-size:38px
}

.welcome p{
  margin:0;
  color:var(--muted);
  line-height:1.5
}

.suggestions{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
  max-width:650px;
  margin:30px auto 0
}

.suggestion{
  border:1px solid var(--border);
  border-radius:13px;
  padding:13px;
  text-align:left;
  background:var(--panel);
  color:var(--text);
  font-size:13px
}

.suggestion:hover{
  border-color:var(--accent);
  background:var(--panel2)
}

/* MESSAGE */

.message{
  display:flex;
  gap:11px;
  margin:22px 0;
  width:100%
}

.message.user{
  justify-content:flex-end
}

.avatar{
  width:36px;
  height:36px;
  min-width:36px;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:var(--accent);
  color:#fff;
  font-size:12px;
  font-weight:900
}

.message.user .avatar{
  order:2;
  background:#374151
}

.message-content{
  min-width:0;
  max-width:82%
}

.bubble{
  padding:13px 16px;
  border-radius:16px;
  line-height:1.65;
  font-size:15px;
  white-space:pre-wrap;
  word-break:break-word
}

.message.ai .bubble{
  background:var(--panel);
  border:1px solid var(--border);
  box-shadow:var(--shadow)
}

.message.user .bubble{
  background:var(--user)
}

.attachment{
  margin-top:7px;
  color:var(--muted);
  font-size:11px
}

.message-tools{
  display:flex;
  flex-wrap:wrap;
  gap:6px;
  margin-top:8px
}

.small-button{
  border:1px solid var(--border);
  background:var(--panel);
  color:var(--muted);
  border-radius:8px;
  padding:5px 9px;
  font-size:11px
}

.small-button:hover{
  color:var(--text);
  border-color:var(--accent)
}

/* SOURCES */

.sources{
  margin-top:13px;
  display:flex;
  flex-direction:column;
  gap:7px
}

.sources-title{
  font-size:13px;
  font-weight:800
}

.source-card{
  display:block;
  padding:10px;
  border:1px solid var(--border);
  border-radius:10px;
  background:var(--panel);
  color:var(--text);
  text-decoration:none
}

.source-card:hover{
  border-color:var(--accent)
}

.source-title{
  font-size:12px;
  font-weight:700;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}

.source-url{
  color:var(--muted);
  font-size:10px;
  margin-top:3px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis
}

/* LOADING */

.typing{
  display:flex;
  gap:5px;
  height:20px;
  align-items:center
}

.typing-dot{
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--muted);
  animation:typing 1.1s infinite
}

.typing-dot:nth-child(2){
  animation-delay:.15s
}

.typing-dot:nth-child(3){
  animation-delay:.3s
}

@keyframes typing{
  0%,80%,100%{opacity:.2}
  40%{opacity:1}
}

/* COMPOSER */

.composer-wrap{
  position:fixed;
  z-index:40;
  left:280px;
  right:0;
  bottom:0;
  padding:25px 20px 17px;
  background:linear-gradient(transparent,var(--bg) 30%)
}

.composer{
  max-width:920px;
  margin:0 auto;
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:18px;
  box-shadow:var(--shadow);
  overflow:hidden
}

.file-preview{
  display:none;
  padding:9px 12px;
  border-bottom:1px solid var(--border);
  color:var(--muted);
  font-size:12px
}

.input-row{
  display:flex;
  align-items:flex-end;
  gap:5px;
  padding:8px
}

.question{
  flex:1;
  min-width:0;
  max-height:150px;
  min-height:43px;
  resize:none;
  border:0;
  outline:0;
  background:transparent;
  color:var(--text);
  padding:10px 5px;
  line-height:1.45
}

.question::placeholder{
  color:var(--muted)
}

.tool-button{
  flex:none;
  width:40px;
  height:40px;
  border:0;
  border-radius:10px;
  background:transparent;
  color:var(--muted);
  font-size:18px
}

.tool-button:hover{
  color:var(--text);
  background:var(--panel2)
}

.send-button{
  flex:none;
  width:42px;
  height:42px;
  border:0;
  border-radius:11px;
  background:var(--accent);
  color:#fff;
  font-weight:900;
  font-size:17px
}

.send-button:hover{
  background:var(--accent2)
}

.send-button:disabled{
  opacity:.5;
  cursor:not-allowed
}

.file-input{
  display:none
}

.composer-hint{
  max-width:920px;
  margin:7px auto 0;
  text-align:center;
  color:var(--muted);
  font-size:10px
}

.error-text{
  color:var(--danger)
}

.overlay{
  display:none;
  position:fixed;
  inset:0;
  z-index:90;
  background:rgba(0,0,0,.45)
}

/* MOBILE */

@media(max-width:800px){

  .sidebar{
    transform:translateX(-100%);
    box-shadow:var(--shadow)
  }

  .sidebar.open{
    transform:translateX(0)
  }

  .overlay.open{
    display:block
  }

  .main{
    width:100%;
    margin-left:0
  }

  .menu-button{
    display:block
  }

  .composer-wrap{
    left:0;
    padding:20px 10px 12px
  }

  .chat-area{
    padding:22px 12px 160px
  }

  .welcome{
    padding:55px 8px 25px
  }

  .welcome h1{
    font-size:30px
  }

  .suggestions{
    grid-template-columns:1fr
  }

  .message-content{
    max-width:88%
  }

  .bubble{
    font-size:14px
  }

  .topbar{
    padding:0 12px
  }
}

@media(max-width:420px){

  .tool-button{
    width:36px
  }

  .send-button{
    width:40px
  }

  .welcome-logo{
    width:56px;
    height:56px
  }

  .welcome h1{
    font-size:27px
  }
}
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">

