    "AIzaSyCjqV35yYSLIQqjNJPisVEjqEUev4S_7RA",

  authDomain:
    "chat-ai-6a0eb.firebaseapp.com",

  projectId:
    "chat-ai-6a0eb",

  storageBucket:
